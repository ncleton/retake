{
  "name": "revue-video",
  "productName": "Revue",
  "version": "1.0.0",
  "description": "Lecteur de revue vidéo : notes horodatées, zones dessinées, notes vocales et rapport pour l'agent de montage.",
  "author": "Nicolas Cléton",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/e2e.mjs",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --x64",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "build": {
    "appId": "org.cleton.revuevideo",
    "productName": "Revue",
    "artifactName": "Revue-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Revue enregistre vos commentaires parlés pendant la relecture d’une vidéo."
      }
    },
    "dmg": {
      "title": "Revue ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Revue",
      "artifactName": "Revue-${version}-windows-x64-installation.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1"
  }
}

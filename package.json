{
  "name": "retake",
  "productName": "Retake",
  "version": "1.0.0",
  "description": "Retake : relecture vidéo à l'image près, commentaires écrits, zones entourées et commentaires vocaux, rapport pour l'agent de montage.",
  "author": "Nicolas Cléton",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.mjs",
    "test": "node test/e2e.mjs",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "build": {
    "appId": "org.cleton.retake",
    "productName": "Retake",
    "artifactName": "Retake-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Retake enregistre vos commentaires parlés pendant la relecture d’une vidéo."
      }
    },
    "dmg": {
      "title": "Retake ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Retake",
      "artifactName": "Retake-${version}-windows-x64-installation.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1"
  },
  "homepage": "https://github.com/ncleton/retake",
  "repository": {
    "type": "git",
    "url": "https://github.com/ncleton/retake.git"
  },
  "bugs": {
    "url": "https://github.com/ncleton/retake/issues"
  }
}
